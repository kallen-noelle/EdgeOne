{
  "name": "airi-pet-site",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "./out",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/animations/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ]
}
